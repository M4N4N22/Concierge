# Concierge — environment template
# Copy to .env and fill secrets. See README for details.

OG_CHAIN_ID=16661
# 16661 = 0G Mainnet (storage uploads use OG_MAINNET_* vars)
# 16602 = Galileo testnet (storage uploads use GALILEO_* / INDEXER_RPC_URL)

# --- Operator compute (Phase 1) — 0G Private Computer Router + 0G Pay pool ---
# Get API key at https://pc.0g.ai — when set, users skip ledger setup; Concierge pays inference.
OG_ROUTER_API_KEY=
OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
OG_ROUTER_MODEL=glm-5.3-flash
# Free compute per wallet per week when subsidized (separate pools)
COMPUTE_FREE_CHAT_WEEKLY_LIMIT=10
COMPUTE_FREE_FEED_WEEKLY_LIMIT=10
# Personalized vault tips (Router call). Cached and reused for the rest of the week.
COMPUTE_FREE_TIPS_WEEKLY_LIMIT=1

# Phase 2 — embed 0G Pay deposit widget in Insights desk (optional)
NEXT_PUBLIC_ENABLE_OG_PAY=true

# --- Direct SDK fallback (advanced / BYO compute) ---
OG_MAINNET_PRIVATE_KEY=
GALILEO_PRIVATE_KEY=
DEPLOYER_ADDRESS=

OG_MAINNET_RPC_URL=https://evmrpc.0g.ai
OG_MAINNET_INDEXER_RPC_URL=https://indexer-storage-turbo.0g.ai
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
INDEXER_RPC_URL=https://indexer-storage-testnet-turbo.0g.ai

VAULT_ADDRESS=0x02AEA2c7E88E2e96CD4A02Ff3BA54f90520893c8
INFTAGENT_ADDRESS=0x721c164D1c7e67e522d50194C342006E36Fde05f

NEXT_PUBLIC_OG_MAINNET_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_MAINNET_VAULT_ADDRESS=0x02AEA2c7E88E2e96CD4A02Ff3BA54f90520893c8
NEXT_PUBLIC_VAULT_ADDRESS=0x845Dc38fCe646C1F0FeB5b607B069D6A62537B81
NEXT_PUBLIC_INFTAGENT_ADDRESS=0x721c164D1c7e67e522d50194C342006E36Fde05f
NEXT_PUBLIC_INFTAGENT_TESTNET_ADDRESS=0x7fE958CaF70cdcEC187f30A216924878e2D89389
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x5cbAdD85bb8f96d8c5b43c7Ae18819F29Cc121Ac
